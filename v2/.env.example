# 複製成 .env 再填。.env 不會進版控。
#
# 前端用（可公開，會出現在瀏覽器裡）
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 客人端 LIFF ID。留空的話開發時會進入預覽模式（畫面能看，送出會被擋）
VITE_LIFF_ID=

# ⚠️ 以下只放在 Cloudflare Worker 的 secret，絕對不要放進前端或版控
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_LOGIN_CHANNEL_ID=
